<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- 自动探测本机 KeePass 2.x 安装路径 (Windows / Linux / macOS) -->
    <KeePassDir Condition="'$(KeePassDir)' == '' and Exists('C:\Program Files\KeePass Password Safe 2\KeePass.exe')">C:\Program Files\KeePass Password Safe 2</KeePassDir>
    <KeePassDir Condition="'$(KeePassDir)' == '' and Exists('C:\Program Files (x86)\KeePass Password Safe 2\KeePass.exe')">C:\Program Files (x86)\KeePass Password Safe 2</KeePassDir>
    <KeePassDir Condition="'$(KeePassDir)' == '' and Exists('/usr/lib/keepass2/KeePass.exe')">/usr/lib/keepass2</KeePassDir>
    <KeePassDir Condition="'$(KeePassDir)' == '' and Exists('/Applications/KeePass2.app/Contents/MacOS')">/Applications/KeePass2.app/Contents/MacOS</KeePassDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluentPass\FluentPass.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="KeePass" Condition="Exists('$(KeePassDir)/KeePass.exe') or Exists('$(KeePassDir)\KeePass.exe')">
      <HintPath Condition="Exists('$(KeePassDir)/KeePass.exe')">$(KeePassDir)/KeePass.exe</HintPath>
      <HintPath Condition="Exists('$(KeePassDir)\KeePass.exe')">$(KeePassDir)\KeePass.exe</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
