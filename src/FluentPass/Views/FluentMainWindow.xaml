<ui:FluentWindow x:Class="FluentPass.Views.FluentMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:FluentPass.ViewModels"
        xmlns:common="clr-namespace:FluentPass.Common"
        xmlns:views="clr-namespace:FluentPass.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="780" Width="1240"
        MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <ResourceDictionary>
            <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <common:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <common:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <common:ExpiredToInfoBarSeverityConverter x:Key="ExpiredToInfoBarSeverityConverter" />
            <x:Array x:Key="EmptySuggestions" Type="{x:Type sys:String}" />

            <Style x:Key="ActionIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="DangerIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>

            <!-- 不可编辑/只读状态下的纯净单行展示样式：去除非编辑状态下的边框与背景，保留划词与复制能力 -->
            <Style x:Key="FluentReadOnlyFieldStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="IBeam" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 不可编辑/只读状态下的纯净多行展示样式（用于备注） -->
            <Style x:Key="FluentReadOnlyMultilineFieldStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Cursor" Value="IBeam" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 现代化 Fluent TitleBar (原生三段式规范布局) -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/FluentPass;component/Resources/AppIcon.ico" />
            </ui:TitleBar.Icon>

            <!-- 左侧 Header: 标题与数据库核心高频操作 (保存、锁定) -->
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock Text="{Binding WindowTitle}" FontTypography="Caption" VerticalAlignment="Center" Margin="6,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               ToolTip="{common:Loc TitleBar_Save_Tooltip}"
                               Command="{Binding SaveDatabaseCommand}">
                        <ui:SymbolIcon Symbol="Save20" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               ToolTip="{common:Loc TitleBar_Lock_Tooltip}"
                               Command="{Binding LockDatabaseCommand}">
                        <ui:SymbolIcon Symbol="LockClosed20" />
                    </ui:Button>

                    <!-- 命令面板（Ctrl+Shift+P）：快捷检索条目与内置命令 -->
                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               ToolTip="{common:Loc TitleBar_QuickAccess_Tooltip}"
                               Command="{Binding OpenQuickAccessCommand}">
                        <ui:SymbolIcon Symbol="Search20" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.Header>

            <!-- 中间 CenterContent: 实时搜索框（WPF-UI 官方 AutoSuggestBox；输入经 TextChanged 事件同步，Enter 提交对齐 KeePass 原生快速搜索） -->
            <ui:TitleBar.CenterContent>
                <ui:AutoSuggestBox x:Name="SearchBox"
                            Width="360"
                            Height="32"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsDatabaseOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Text="{Binding SearchText}"
                            PlaceholderText="{common:Loc TitleBar_Search_Placeholder}"
                            Icon="{ui:SymbolIcon Search20}"
                            ClearButtonEnabled="True"
                            TextChanged="OnSearchBoxTextChanged"
                            QuerySubmitted="OnSearchQuerySubmitted" />
            </ui:TitleBar.CenterContent>

            <!-- 右侧 TrailingContent: 原版协同、外观主题与设置中心 -->
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               ToolTip="{common:Loc TitleBar_ToggleOriginal_Tooltip}"
                               Command="{Binding ToggleOriginalWindowCommand}">
                        <ui:SymbolIcon Symbol="WindowDevTools20" />
                    </ui:Button>

                    <!-- 在线更新提醒：仅在后台检测到新版本时出现（Installed / NotWritable），
                         本身即提示信号，无需常驻也无需红点；点击弹出 Flyout 引导完成更新 -->
                    <ui:Button x:Name="UpdateButton"
                               Style="{StaticResource ActionIconButtonStyle}"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               Click="OnUpdateButtonClick"
                               ToolTip="{common:Loc TitleBar_Update_Tooltip}"
                               Visibility="{Binding Update.IsBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="ArrowCircleUp20" />
                    </ui:Button>

                    <!-- 主题切换下拉按钮 -->
                    <ui:DropDownButton Style="{StaticResource ActionIconButtonStyle}"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       ToolTip="{common:Loc TitleBar_Theme_Tooltip}">
                        <ui:DropDownButton.Icon>
                            <ui:SymbolIcon Symbol="WeatherMoon20" />
                        </ui:DropDownButton.Icon>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <ui:MenuItem Header="{common:Loc TitleBar_Theme_Dark}"
                                             Icon="{ui:SymbolIcon WeatherMoon24}"
                                             Command="{Binding SwitchThemeCommand}"
                                             CommandParameter="Dark" />
                                <ui:MenuItem Header="{common:Loc TitleBar_Theme_Light}"
                                             Icon="{ui:SymbolIcon WeatherSunny24}"
                                             Command="{Binding SwitchThemeCommand}"
                                             CommandParameter="Light" />
                                <ui:MenuItem Header="{common:Loc TitleBar_Theme_System}"
                                             Icon="{ui:SymbolIcon Desktop24}"
                                             Command="{Binding SwitchThemeCommand}"
                                             CommandParameter="System" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <!-- 设置中心入口按钮 -->
                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               ToolTip="{common:Loc TitleBar_Settings_Tooltip}"
                               Command="{Binding OpenSettingsCommand}">
                        <ui:SymbolIcon Symbol="Settings20" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 在线更新 Flyout：点 titlebar 更新按钮弹出。简化面板——状态标题 + 正文 + 按需操作按钮；
             无待处理状态时收起按钮组，仅显示状态文案（检查入口在设置页，遵循「再简化」决策） -->
        <ui:Flyout x:Name="UpdateFlyout"
                   Grid.Row="0">
            <StackPanel MinWidth="280" MaxWidth="360" Margin="4">
                <ui:TextBlock Text="{Binding Update.BarTitle, Mode=OneWay}"
                              FontTypography="BodyStrong"
                              TextWrapping="Wrap" />
                <ui:TextBlock Text="{Binding Update.BarMessage, Mode=OneWay}"
                              FontTypography="Body"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"
                              Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,12,0,0"
                            Visibility="{Binding Update.CanRestart, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Button Appearance="Primary"
                               Margin="0,0,8,0"
                               Content="{common:Loc Update_Restart_Button}"
                               Icon="{ui:SymbolIcon ArrowClockwise20}"
                               Command="{Binding Update.RestartCommand}" />
                    <ui:Button Appearance="Transparent"
                               Content="{common:Loc Update_Dismiss_Button}"
                               Command="{Binding Update.DismissCommand}" />
                </StackPanel>
                <!-- 下载失败：提供前往发布页面手动下载更新的链接及忽略按钮 -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,12,0,0"
                            Visibility="{Binding Update.CanDownloadManually, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Button Appearance="Primary"
                               Margin="0,0,8,0"
                               Content="{common:Loc Update_ManualDownload_Button}"
                               Icon="{ui:SymbolIcon ArrowDownload20}"
                               Command="{Binding Update.OpenManualDownloadCommand}" />
                    <ui:Button Appearance="Transparent"
                               Content="{common:Loc Update_Dismiss_Button}"
                               Command="{Binding Update.DismissCommand}" />
                </StackPanel>
                <!-- 需人工替换：一键打开两个目录（下载位置 + 插件目录），引导复制粘贴完成更新 -->
                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding Update.CanOpenFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Text="{common:Loc Update_Manual_Steps}"
                                  FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Appearance="Primary"
                                   Margin="0,0,8,0"
                                   Content="{common:Loc Update_OpenDownload_Button}"
                                   Icon="{ui:SymbolIcon FolderOpen20}"
                                   Command="{Binding Update.OpenDownloadFolderCommand}" />
                        <ui:Button Appearance="Secondary"
                                   Content="{common:Loc Update_OpenPluginDir_Button}"
                                   Icon="{ui:SymbolIcon FolderOpen20}"
                                   Command="{Binding Update.OpenPluginFolderCommand}" />
                    </StackPanel>
                    <ui:Button Appearance="Transparent"
                               Margin="0,8,0,0"
                               Content="{common:Loc Update_Dismiss_Button}"
                               Command="{Binding Update.DismissCommand}" />
                </StackPanel>
            </StackPanel>
        </ui:Flyout>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <!-- 密码库工作区视图 (设置中心关闭时展示) -->
            <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
            <!-- 视图 1: 数据库已锁定 -->
            <Grid Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="LockClosed48" FontSize="64" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{common:Loc Db_Locked_Title}"
                                  FontTypography="TitleLarge"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8" />
                    <ui:TextBlock Text="{Binding DatabaseName}"
                                  FontTypography="Body"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24" />
                    <ui:Button Appearance="Primary"
                               Content="{common:Loc Db_Locked_Button}"
                               Icon="{ui:SymbolIcon Key24}"
                               HorizontalAlignment="Center"
                               Padding="24,10"
                               Command="{Binding UnlockDatabaseCommand}" />
                </StackPanel>
            </Grid>

            <!-- 视图 2: 数据库未打开 -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDatabaseOpen}" Value="False" />
                                    <Condition Binding="{Binding IsLocked}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="64" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{common:Loc Db_NotOpen_Title}"
                                  FontTypography="TitleLarge"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8" />
                    <ui:TextBlock Text="{common:Loc Db_NotOpen_Subtitle}"
                                  FontTypography="Body"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24" />
                    <ui:Button Appearance="Secondary"
                               Content="{common:Loc Db_NotOpen_Button}"
                               HorizontalAlignment="Center"
                               Command="{Binding ToggleOriginalWindowCommand}" />
                </StackPanel>
            </Grid>

            <!-- 视图 3: 三栏现代 Fluent 工作区容器 (全伸展布局) -->
            <Grid Visibility="{Binding IsDatabaseOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <!-- 左栏: 分组树 -->
                    <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
                    <ColumnDefinition Width="Auto" />
                    <!-- 中栏: 条目列表与搜索 -->
                    <ColumnDefinition Width="380" MinWidth="280" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <!-- 右栏: 详情与内联编辑 -->
                    <ColumnDefinition Width="*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- ================= 左栏: 分组树原生 Card (全高延伸) ================= -->
                <ui:Card Grid.Column="0"
                         Margin="8,4,4,8"
                         Padding="8"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 左栏顶栏工具 -->
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <ui:TextBlock Text="{common:Loc Groups_Title}" FontTypography="BodyStrong" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Style="{StaticResource DangerIconButtonStyle}"
                                           ToolTip="{common:Loc Groups_EmptyRecycleBin_Tooltip}"
                                           Visibility="{Binding IsRecycleBinSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Command="{Binding EmptyRecycleBinCommand}">
                                    <ui:SymbolIcon Symbol="Dismiss20" />
                                </ui:Button>
                                <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                                           ToolTip="{common:Loc Groups_NewSubGroup_Tooltip}"
                                           Command="{Binding NewGroupCommand}">
                                    <ui:SymbolIcon Symbol="FolderAdd20" />
                                </ui:Button>
                                <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                                           ToolTip="{common:Loc Groups_DeleteGroup_Tooltip}"
                                           Command="{Binding DeleteGroupCommand}">
                                    <ui:SymbolIcon Symbol="Delete20" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!-- 现代 Fluent 递归分组树 -->
                        <TreeView Grid.Row="1"
                                  x:Name="GroupsTreeView"
                                  ItemsSource="{Binding RootGroups}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  VerticalAlignment="Stretch"
                                  AllowDrop="True"
                                  SelectedItemChanged="OnTreeViewSelectedItemChanged"
                                  PreviewMouseLeftButtonDown="OnTreeViewPreviewMouseLeftButtonDown"
                                  PreviewMouseRightButtonDown="OnTreeViewPreviewMouseRightButtonDown"
                                  ContextMenuOpening="OnTreeViewContextMenuOpening"
                                  DragOver="OnGroupsTreeViewDragOver"
                                  DragLeave="OnGroupsTreeViewDragLeave"
                                  Drop="OnGroupsTreeViewDrop">
                            <TreeView.Resources>
                                <common:BindingProxy x:Key="MainVmProxy" Data="{Binding}" />
                            </TreeView.Resources>
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_NewSubgroup}"
                                                 Icon="{ui:SymbolIcon FolderAdd20}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.NewGroupCommand}"
                                                 CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedGroup}" />
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_NewEntry}"
                                                 Icon="{ui:SymbolIcon Add20}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.NewEntryInGroupCommand}"
                                                 CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedGroup}" />
                                    <Separator />
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_EditGroup}"
                                                 Icon="{ui:SymbolIcon Edit20}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.EditGroupCommand}"
                                                 CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedGroup}" />
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_DuplicateGroup}"
                                                 Icon="{ui:SymbolIcon Copy20}"
                                                 IsEnabled="{Binding Source={StaticResource MainVmProxy}, Path=Data.CanDuplicateSelectedGroup}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.DuplicateGroupCommand}"
                                                 CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedGroup}" />
                                    <Separator />
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_SortSubgroups}"
                                                 Icon="{ui:SymbolIcon ArrowSort20}"
                                                 IsEnabled="{Binding Source={StaticResource MainVmProxy}, Path=Data.CanSortSelectedSubgroups}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.SortSubgroupsCommand}"
                                                 CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedGroup}" />
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_MoveUp}"
                                                 Icon="{ui:SymbolIcon ArrowUp20}"
                                                 IsEnabled="{Binding Source={StaticResource MainVmProxy}, Path=Data.CanMoveSelectedGroupUp}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.MoveGroupUpCommand}"
                                                 CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedGroup}" />
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_MoveDown}"
                                                 Icon="{ui:SymbolIcon ArrowDown20}"
                                                 IsEnabled="{Binding Source={StaticResource MainVmProxy}, Path=Data.CanMoveSelectedGroupDown}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.MoveGroupDownCommand}"
                                                 CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedGroup}" />
                                    <Separator />
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_ExpandAll}"
                                                 Icon="{ui:SymbolIcon ArrowExpandAll20}"
                                                 IsEnabled="{Binding Source={StaticResource MainVmProxy}, Path=Data.CanExpandOrCollapseSelectedGroup}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.ExpandAllGroupsCommand}"
                                                 CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedGroup}" />
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_CollapseAll}"
                                                 Icon="{ui:SymbolIcon ArrowCollapseAll20}"
                                                 IsEnabled="{Binding Source={StaticResource MainVmProxy}, Path=Data.CanExpandOrCollapseSelectedGroup}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.CollapseAllGroupsCommand}"
                                                 CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedGroup}" />
                                    <Separator Visibility="{Binding Source={StaticResource MainVmProxy}, Path=Data.IsRecycleBinSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_EmptyRecycleBin}"
                                                 Icon="{ui:SymbolIcon Dismiss20}"
                                                 Visibility="{Binding Source={StaticResource MainVmProxy}, Path=Data.IsRecycleBinSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.EmptyRecycleBinCommand}" />
                                    <Separator />
                                    <ui:MenuItem Header="{common:Loc Groups_ContextMenu_DeleteGroup}"
                                                 Icon="{ui:SymbolIcon Delete20}"
                                                 IsEnabled="{Binding Source={StaticResource MainVmProxy}, Path=Data.CanDeleteSelectedGroup}"
                                                 Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.DeleteGroupCommand}"
                                                 CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedGroup}" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding IconSource}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <ui:TextBlock Grid.Column="1" Text="{Binding Name}" FontTypography="Body" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ui:InfoBadge Grid.Column="2"
                                                      Value="{Binding EntryCount}"
                                                      Severity="Informational"
                                                      Margin="8,0,4,0"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="4,3" />
                                    <Setter Property="AllowDrop" Value="True" />
                                    <EventSetter Event="DragOver" Handler="OnTreeViewItemDragOver" />
                                    <EventSetter Event="DragLeave" Handler="OnTreeViewItemDragLeave" />
                                    <EventSetter Event="Drop" Handler="OnTreeViewItemDrop" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>
                </ui:Card>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- ================= 中栏: 条目列表与搜索原生 Card (全高延伸，彻底杜绝列表为空时的塌陷) ================= -->
                <ui:Card Grid.Column="2"
                         Margin="4,4,4,8"
                         Padding="8"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 条目统计信息与新建条目合并行（SplitButton：主按新建空白，下拉从模板新建） -->
                        <Grid Grid.Row="0" Margin="4,2,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          VerticalAlignment="Center"
                                          Margin="2,0,8,0"
                                          TextTrimming="CharacterEllipsis"
                                          ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="{Binding EntriesSummaryText}" />
                            <Grid Grid.Column="1">
                                <!-- 无模板时退化为普通按钮：SplitButton 的箭头分区不再出现，
                                     避免用户点开一个只有“未配置模板”占位项的空气泡 -->
                                <ui:Button Appearance="Primary"
                                           Content="{common:Loc Entries_NewButton}"
                                           Icon="{ui:SymbolIcon Add20}"
                                           Command="{Binding NewEntryCommand}"
                                           Visibility="{Binding HasTemplates, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                                <ui:SplitButton Appearance="Primary"
                                                Content="{common:Loc Entries_NewButton}"
                                                Icon="{ui:SymbolIcon Add20}"
                                                Command="{Binding NewEntryCommand}"
                                                Visibility="{Binding HasTemplates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ui:SplitButton.Flyout>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <ItemsControl ItemsSource="{Binding Templates}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ui:MenuItem Header="{Binding Title}"
                                                                     Command="{Binding DataContext.NewEntryFromTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                     CommandParameter="{Binding Model}">
                                                            <ui:MenuItem.Icon>
                                                                <ui:ImageIcon Source="{Binding IconSource}" Width="16" Height="16" />
                                                            </ui:MenuItem.Icon>
                                                        </ui:MenuItem>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ContextMenu>
                                    </ui:SplitButton.Flyout>
                                </ui:SplitButton>
                            </Grid>
                        </Grid>

                        <!-- 面包屑分组导航（根→…→当前；仅根分组时隐藏）。
                             注：不使用 ui:BreadcrumbBar——WPF-UI 4.3.0 该控件在 Collapsed 状态下不会生成条目容器，
                             而 UpdateLastContainer 只判 ItemContainerGenerator.Items.Count 就直接解引用
                             ContainerFromItem 的结果，于是在 Loaded 广播阶段抛 NRE（发生在渲染消息泵内，
                             会杀死宿主进程）。已报上游 lepoco/wpfui#1776，故以标准 Button + ChevronRight
                             组合实现同等交互 -->
                        <ItemsControl Grid.Row="1"
                                      x:Name="BreadcrumbTrail"
                                      Margin="4,0,4,6"
                                      ItemsSource="{Binding BreadcrumbItems}"
                                      Visibility="{Binding HasBreadcrumb, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Appearance="Transparent"
                                                   BorderThickness="0"
                                                   Padding="4,2"
                                                   MinHeight="0"
                                                   Focusable="False"
                                                   Cursor="Hand"
                                                   IsEnabled="{Binding IsCurrent, Converter={StaticResource InverseBooleanConverter}}"
                                                   Command="{Binding DataContext.NavigateToBreadcrumbCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                                   CommandParameter="{Binding}">
                                            <Grid>
                                                <!-- 回收站节点特殊化：垃圾桶图标 + 警示色，与普通分组区分 -->
                                                <StackPanel Orientation="Horizontal"
                                                            ToolTip="{common:Loc Breadcrumb_RecycleBin_Tooltip}"
                                                            Visibility="{Binding IsRecycleBin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ui:SymbolIcon Symbol="Delete20" FontSize="12" Margin="0,0,4,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <ui:TextBlock Text="{Binding Name}"
                                                                  FontTypography="Caption"
                                                                  TextTrimming="CharacterEllipsis"
                                                                  Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                </StackPanel>
                                                <ui:TextBlock Text="{Binding Name}"
                                                              FontTypography="Caption"
                                                              TextTrimming="CharacterEllipsis"
                                                              Visibility="{Binding IsRecycleBin, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                            </Grid>
                                        </ui:Button>
                                        <ui:SymbolIcon Symbol="ChevronRight20" FontSize="10" Margin="2,1,2,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 虚拟化原生 ui:ListView 条目列表与空数据友好提示 -->
                        <Grid Grid.Row="2" VerticalAlignment="Stretch">
                            <ui:ListView x:Name="EntriesListView"
                                         ItemsSource="{Binding FilteredEntries}"
                                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                         SelectionMode="Extended"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalAlignment="Stretch"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.IsDeferredScrollingEnabled="False"
                                         HorizontalContentAlignment="Stretch">
                                <ui:ListView.Resources>
                                    <common:BindingProxy x:Key="MainVmProxy" Data="{Binding}" />
                                </ui:ListView.Resources>
                                <ui:ListView.ItemContainerStyle>
                                    <Style TargetType="ui:ListViewItem" BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListViewItemPreviewMouseLeftButtonDown" />
                                        <EventSetter Event="PreviewMouseMove" Handler="OnListViewItemPreviewMouseMove" />
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnListViewItemPreviewMouseLeftButtonUp" />
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListViewItemPreviewMouseRightButtonDown" />
                                        <EventSetter Event="MouseDoubleClick" Handler="OnEntryListDoubleClick" />
                                    </Style>
                                </ui:ListView.ItemContainerStyle>
                                <ui:ListView.ContextMenu>
                                    <ContextMenu>
                                        <ui:MenuItem Header="{common:Loc Menu_CopyPassword}"
                                                     InputGestureText="Ctrl+C"
                                                     Icon="{ui:SymbolIcon Copy20}"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.CopySelectedPasswordCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="{common:Loc Menu_CopyUsername}"
                                                     InputGestureText="Ctrl+B"
                                                     Icon="{ui:SymbolIcon Person20}"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.CopySelectedUsernameCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="{common:Loc Menu_CopyUrl}"
                                                     Icon="{ui:SymbolIcon Link20}"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.CopySelectedUrlCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="{common:Loc Menu_OpenUrl}"
                                                     InputGestureText="Ctrl+U"
                                                     Icon="{ui:SymbolIcon Open20}"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.OpenSelectedUrlCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="{common:Loc Menu_AutoType}"
                                                     InputGestureText="Ctrl+V"
                                                     Icon="{ui:SymbolIcon Keyboard20}"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.AutoTypeSelectedCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <Separator />
                                        <ui:MenuItem Header="{common:Loc Menu_DuplicateEntry}"
                                                     Icon="{ui:SymbolIcon Copy20}"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.DuplicateEntryCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="{common:Loc Menu_RestoreFromRecycleBin}"
                                                     Icon="{ui:SymbolIcon ArrowUp20}"
                                                     Visibility="{Binding Source={StaticResource MainVmProxy}, Path=Data.CanRestoreSelectedEntry, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.RestoreEntryFromRecycleBinCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <Separator />
                                        <ui:MenuItem Header="{common:Loc Menu_EditEntry}"
                                                     InputGestureText="Enter"
                                                     Icon="{ui:SymbolIcon Edit20}"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.EditSelectedEntryCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="{common:Loc Menu_DeleteEntry}"
                                                     InputGestureText="Del"
                                                     Icon="{ui:SymbolIcon Delete20}"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.DeleteEntryCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <Separator />
                                        <ui:MenuItem Header="{common:Loc Menu_OpenOriginalDialog}"
                                                     Icon="{ui:SymbolIcon WindowDevTools24}"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.OpenOriginalSelectedEntryCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                    </ContextMenu>
                                </ui:ListView.ContextMenu>
                                <ui:ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 图标 -->
                                            <Image Grid.Column="0" Source="{Binding IconSource}" Width="24" Height="24" Margin="4,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                                            <!-- 条目文本摘要 -->
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ui:TextBlock Grid.Row="0" Text="{Binding Title}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                                    <ui:TextBlock Text="{Binding UserName}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                    <ui:TextBlock Text="{Binding LastModifiedDisplay}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <!-- 原生 Tags 徽标（至多 3 个 + “+N” 折叠，避免撑高列表行） -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal"
                                                              Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              Margin="0,3,0,0">
                                                    <ItemsControl ItemsSource="{Binding VisibleTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ui:InfoBadge Value="{Binding}" Severity="Success" Margin="0,0,4,0" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ui:InfoBadge Value="{Binding OverflowTagsDisplay}"
                                                                  Severity="Informational"
                                                                  Visibility="{Binding HasTagOverflow, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ui:ListView.ItemTemplate>
                            </ui:ListView>

                            <!-- 当条目列表为空时的友好 Fluent 占位卡片 -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding FilteredEntries.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="44" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10" />
                                <ui:TextBlock Text="{common:Loc Empty_NoEntries_Title}" FontTypography="BodyStrong" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <ui:TextBlock Text="{common:Loc Empty_NoEntries_Description}"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              HorizontalAlignment="Center"
                                              TextWrapping="Wrap"
                                              TextAlignment="Center"
                                              MaxWidth="240"
                                              Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ui:Card>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- ================= 右栏: 条目详情与内联编辑原生 Card (全高延伸) ================= -->
                <ui:Card Grid.Column="4"
                         Margin="4,4,8,8"
                         Padding="16"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                    <Grid VerticalAlignment="Stretch">
                        <!-- 未选择条目时的空状态 -->
                        <Grid VerticalAlignment="Stretch">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDetail}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="56" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />
                                <ui:TextBlock Text="{common:Loc Empty_NoSelectedEntry_Title}" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <ui:TextBlock Text="{common:Loc Empty_NoSelectedEntry_Description}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 已选择条目的详情面板 (采用 DynamicScrollViewer 实现平滑流动滚动) -->
                        <ui:DynamicScrollViewer x:Name="DetailScrollViewer" DataContext="{Binding CurrentDetail}" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" Focusable="False" ScrollChanged="OnDetailScrollViewerScrollChanged" PreviewMouseWheel="OnDetailScrollViewerPreviewMouseWheel">
                            <ui:DynamicScrollViewer.Style>
                                <Style TargetType="ui:DynamicScrollViewer" BasedOn="{StaticResource {x:Type ui:DynamicScrollViewer}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:DynamicScrollViewer.Style>

                            <StackPanel Margin="0,0,8,0">
                                <!-- 过期警示（已过期/临近过期，口径与原生“即将过期”一致）
                                     严重级别由 IsExpiryExpired 决定：已过期→Error，临近→Warning，两者不共用同一色阶 -->
                                <ui:InfoBar IsOpen="{Binding IsExpiryWarningVisible, Mode=TwoWay}"
                                            IsClosable="False"
                                            Severity="{Binding IsExpiryExpired, Converter={StaticResource ExpiredToInfoBarSeverityConverter}}"
                                            Title="{common:Loc Detail_Expiry_WarningTitle}"
                                            Message="{Binding ExpiryWarningText}"
                                            Margin="0,0,0,10" />

                                <!-- 顶部标题与操作卡片 -->
                                <ui:Card Margin="0,0,0,14" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0" Source="{Binding IconSource}" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        
                                        <!-- 查看模式标题 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <ui:TextBlock Text="{Binding Title}" FontTypography="Title" TextTrimming="CharacterEllipsis" />
                                            <ui:TextBlock Text="{Binding LastModifiedSummary}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- 编辑模式标题 (单行平齐对齐，与保存/取消按钮位于同一水平居中线上) -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ui:TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="{common:Loc Detail_TitlePlaceholder}"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        ClearButtonEnabled="True" />
                                        </Grid>

                                        <!-- 动作按钮栏 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 查看模式下的工具 -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <ui:Button Appearance="Primary" Margin="0,0,6,0" Command="{Binding BeginEditCommand}" Icon="{ui:SymbolIcon Edit20}" Content="{common:Loc Detail_Button_Edit}" />
                                                <ui:Button Style="{StaticResource ActionIconButtonStyle}" ToolTip="{common:Loc Detail_AutoType_Tooltip}" Command="{Binding PerformAutoTypeCommand}">
                                                    <ui:SymbolIcon Symbol="Keyboard20" />
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource ActionIconButtonStyle}" ToolTip="{common:Loc Detail_OpenOriginalDialog_Tooltip}" Command="{Binding InvokeOriginalEntryDialogCommand}">
                                                    <ui:SymbolIcon Symbol="Open20" />
                                                </ui:Button>
                                            </StackPanel>

                                            <!-- 编辑模式下的工具 -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ui:Button Appearance="Primary" Margin="0,0,6,0" Command="{Binding SaveEditCommand}" Icon="{ui:SymbolIcon Checkmark20}" Content="{common:Loc Detail_Button_Save}" />
                                                <ui:Button Appearance="Secondary" Command="{Binding CancelEditCommand}" Content="{common:Loc Detail_Button_Cancel}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <!-- ================= 字段 1: 用户名 ================= -->
                                <ui:Card Margin="0,0,0,10" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                            <ui:SymbolIcon Symbol="Person20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="{common:Loc Detail_Field_UserName}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- 查看模式（不可编辑）：平整纯净展示，支持鼠标划词与一键复制 -->
                                        <Grid Grid.Row="1" Grid.Column="0" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" VerticalAlignment="Center">
                                            <TextBox Style="{StaticResource FluentReadOnlyFieldStyle}"
                                                     Text="{Binding UserName}"
                                                     FontSize="14"
                                                     Visibility="{Binding UserName, Converter={StaticResource StringToVisibilityConverter}}" />
                                            <ui:TextBlock Text="{common:Loc Detail_NotSet_UserName}"
                                                          FontTypography="Body"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          FontStyle="Italic"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding UserName, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" />
                                        </Grid>

                                        <!-- 编辑模式（可编辑）：支持自动建议的 Fluent AutoSuggestBox，对齐 KeePass 原生自动补全行为 -->
                                        <ui:AutoSuggestBox Grid.Row="1" Grid.Column="0"
                                                           x:Name="EditUserNameBox"
                                                           Text="{Binding EditUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           OriginalItemsSource="{Binding UserNameSuggestions, FallbackValue={StaticResource EmptySuggestions}, TargetNullValue={StaticResource EmptySuggestions}}"
                                                           PlaceholderText="{common:Loc Detail_Placeholder_UserName}"
                                                           ClearButtonEnabled="True"
                                                           Icon="{x:Null}"
                                                           TextChanged="OnEditUserNameTextChanged"
                                                           SuggestionChosen="OnEditUserNameSuggestionChosen"
                                                           QuerySubmitted="OnEditUserNameQuerySubmitted"
                                                           PreviewKeyDown="OnEditUserNamePreviewKeyDown"
                                                           Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="8,0,0,0" ToolTip="{common:Loc Detail_CopyUserName_Tooltip}" Command="{Binding CopyUsernameCommand}">
                                            <ui:SymbolIcon Symbol="Copy20" />
                                        </ui:Button>
                                    </Grid>
                                </ui:Card>

                                <!-- ================= 字段 2: 密码安全交互区 ================= -->
                                <ui:Card Margin="0,0,0,10" Padding="14,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Key20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ui:TextBlock Text="{common:Loc Detail_Field_Password}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- 倒计时安全提示使用 Fluent InfoBadge -->
                                            <ui:InfoBadge HorizontalAlignment="Right"
                                                          Severity="Caution"
                                                          Value="{Binding PasswordRevealBadgeText}"
                                                          Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>

                                        <!-- 查看模式下的密码（不可编辑状态：平整展示与安全遮蔽） -->
                                        <Grid Margin="0,0,0,8" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 掩码状态展示（无边框平整展示） -->
                                            <TextBox Grid.Column="0" Style="{StaticResource FluentReadOnlyFieldStyle}"
                                                     Text="{Binding PasswordMasked}" FontFamily="Consolas" FontSize="16"
                                                     Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                                            <!-- 明文展开状态展示（无边框平整展示） -->
                                            <TextBox Grid.Column="0" Style="{StaticResource FluentReadOnlyFieldStyle}"
                                                     Text="{Binding RevealedPassword}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                                     Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <!-- 切换明文按钮 -->
                                            <ui:Button Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="8,0,0,0"
                                                       ToolTip="{common:Loc Detail_TogglePassword_Tooltip}" Command="{Binding TogglePasswordVisibilityCommand}">
                                                <ui:SymbolIcon Symbol="Eye20" />
                                            </ui:Button>

                                            <!-- 复制密码按钮 -->
                                            <ui:Button Grid.Column="2" Appearance="Primary" Margin="4,0,0,0"
                                                       ToolTip="{common:Loc Detail_CopyPassword_Tooltip}" Command="{Binding CopyPasswordCommand}">
                                                <ui:SymbolIcon Symbol="Copy20" />
                                            </ui:Button>
                                        </Grid>

                                        <!-- 编辑模式下的密码（可编辑状态：表单密码输入框，带边框和占位提示） -->
                                        <Grid Margin="0,0,0,8" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 明文输入框 -->
                                            <ui:TextBox Grid.Column="0"
                                                        Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}"
                                                        FontFamily="Consolas"
                                                        PlaceholderText="{common:Loc Detail_Placeholder_Password}"
                                                        Visibility="{Binding IsEditPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <!-- 密文输入框（RevealButtonEnabled=False：显隐统一由右侧按钮控制，避免双眼睛） -->
                                            <ui:PasswordBox Grid.Column="0"
                                                            Password="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                            FontFamily="Consolas"
                                                            RevealButtonEnabled="False"
                                                            Visibility="{Binding IsEditPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                                            <!-- 切换防窥显隐 -->
                                            <ui:Button Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="8,0,0,0"
                                                       ToolTip="{common:Loc Detail_ToggleEditPassword_Tooltip}" Command="{Binding ToggleEditPasswordVisibilityCommand}">
                                                <ui:SymbolIcon Symbol="Eye20" />
                                            </ui:Button>

                                            <!-- 复制编辑中的密码（所见即所复，走官方剪贴板链路） -->
                                            <ui:Button Grid.Column="2" Style="{StaticResource ActionIconButtonStyle}" Margin="4,0,0,0"
                                                       ToolTip="{common:Loc Detail_CopyPassword_Tooltip}" Command="{Binding CopyEditPasswordCommand}">
                                                <ui:SymbolIcon Symbol="Copy20" />
                                            </ui:Button>

                                            <!-- 内联快速生成（官方 PwGenerator + 宿主自动生成档案） -->
                                            <ui:Button Grid.Column="3" Style="{StaticResource ActionIconButtonStyle}" Margin="4,0,0,0"
                                                       ToolTip="{common:Loc Detail_QuickGenerate_Tooltip}" Command="{Binding GeneratePasswordQuickCommand}">
                                                <ui:SymbolIcon Symbol="ArrowClockwise20" />
                                            </ui:Button>

                                            <!-- 调起原版密码生成器 -->
                                            <ui:Button Grid.Column="4" Style="{StaticResource ActionIconButtonStyle}" Margin="4,0,0,0"
                                                       ToolTip="{common:Loc Detail_InvokePwGen_Tooltip}" Command="{Binding InvokePwGeneratorCommand}">
                                                <ui:SymbolIcon Symbol="Wand20" />
                                            </ui:Button>
                                        </Grid>

                                        <!-- 密码质量与熵值估算指示条 -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Height="4" VerticalAlignment="Center"
                                                         Value="{Binding PasswordQualityPercent}" Maximum="100"
                                                         Foreground="{Binding PasswordQualityColor}" Margin="0,0,8,0" />
                                            <ui:TextBlock Grid.Column="1" Text="{Binding PasswordQualityText}" FontTypography="Caption"
                                                          Foreground="{Binding PasswordQualityColor}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <!-- ================= TOTP 算法超出宿主能力时明确告警 ================= -->
                                <!-- 种子存在但算法不支持（如 Steam 字符码）：不能静默隐藏卡片，否则用户会以为插件漏支持 -->
                                <ui:InfoBar IsOpen="{Binding IsTotpUnsupported, Mode=OneWay}"
                                            IsClosable="False"
                                            Severity="Informational"
                                            Title="{common:Loc Detail_Totp_Header}"
                                            Message="{Binding TotpUnsupportedText}"
                                            Margin="0,0,0,10" />

                                <!-- ================= 字段 2.5: TOTP 一次性验证码（宿主 SprEngine {TIMEOTP} 生成） ================= -->
                                <ui:Card Margin="0,0,0,10" Padding="14,10"
                                         Visibility="{Binding HasTotp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 周期倒计时环（低于 5 秒转告警色，提示即将换码） -->
                                        <ui:ProgressRing Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0"
                                                         IsIndeterminate="False"
                                                         Progress="{Binding TotpCountdownPercent}">
                                            <ui:ProgressRing.Style>
                                                <Style TargetType="ui:ProgressRing">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTotpExpiringSoon}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:ProgressRing.Style>
                                        </ui:ProgressRing>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <ui:TextBlock Text="{common:Loc Detail_Totp_Header}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="{Binding TotpCode}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                                                          VerticalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- 剩余秒数徽标 -->
                                        <ui:InfoBadge Grid.Column="2" Value="{Binding TotpCountdownText}" Severity="Informational"
                                                      VerticalAlignment="Center" Margin="0,0,8,0" />

                                        <!-- 复制验证码（官方 ClipboardUtil 条目语义） -->
                                        <ui:Button Grid.Column="3" Style="{StaticResource ActionIconButtonStyle}"
                                                   ToolTip="{common:Loc Detail_Totp_CopyTooltip}" Command="{Binding CopyTotpCommand}">
                                            <ui:SymbolIcon Symbol="Copy20" />
                                        </ui:Button>
                                    </Grid>
                                </ui:Card>

                                <!-- ================= 字段 3: 网址 (URL) ================= -->
                                <ui:Card Margin="0,0,0,10" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                            <ui:SymbolIcon Symbol="Globe20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="{common:Loc Detail_Field_Url}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- 查看模式（不可编辑）：平整展示，支持划词复制与快捷打开 -->
                                        <Grid Grid.Row="1" Grid.Column="0" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" VerticalAlignment="Center">
                                            <TextBox Style="{StaticResource FluentReadOnlyFieldStyle}"
                                                     Text="{Binding Url}"
                                                     FontSize="14"
                                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                     Visibility="{Binding Url, Converter={StaticResource StringToVisibilityConverter}}" />
                                            <ui:TextBlock Text="{common:Loc Detail_NotSet_Url}"
                                                          FontTypography="Body"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          FontStyle="Italic"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding Url, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" />
                                        </Grid>

                                        <!-- 编辑模式（可编辑）：带边框的 Fluent 输入框 -->
                                        <ui:TextBox Grid.Row="1" Grid.Column="0"
                                                    Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{common:Loc Detail_Placeholder_Url}"
                                                    ClearButtonEnabled="True"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="8,0,0,0" ToolTip="{common:Loc Detail_OpenUrl_Tooltip}" Command="{Binding OpenUrlCommand}">
                                            <ui:SymbolIcon Symbol="Open20" />
                                        </ui:Button>
                                        <ui:Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionIconButtonStyle}" Margin="4,0,0,0" ToolTip="{common:Loc Detail_CopyUrl_Tooltip}" Command="{Binding CopyUrlCommand}">
                                            <ui:SymbolIcon Symbol="Copy20" />
                                        </ui:Button>
                                    </Grid>
                                </ui:Card>

                                <!-- ================= 字段 3.5: 标签（原生 PwEntry.Tags） ================= -->
                                <ui:CardExpander Header="{common:Loc Detail_Field_Tags}"
                                                 Icon="{ui:SymbolIcon Bookmark24}"
                                                 IsExpanded="True"
                                                 Margin="0,0,0,10"
                                                 Visibility="{Binding IsTagsSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,4,0,0">
                                        <!-- 查看模式：原生标签徽标流 -->
                                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <ItemsControl ItemsSource="{Binding Tags}"
                                                          Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ui:InfoBadge Value="{Binding}" Severity="Success" Margin="0,0,6,6" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ui:TextBlock Text="{common:Loc Detail_Tags_Empty}"
                                                          FontTypography="Body"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          FontStyle="Italic"
                                                          Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                        </StackPanel>

                                        <!-- 编辑模式：按原生语义以逗号/分号分隔，保存时官方 StrUtil.StringToTags 规范化 -->
                                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ui:TextBox Text="{Binding EditTagsText, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="{common:Loc Detail_Tags_EditPlaceholder}"
                                                        ClearButtonEnabled="True" />
                                            <ui:TextBlock Text="{common:Loc Detail_Tags_EditHint}"
                                                          FontTypography="Caption"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </ui:CardExpander>

                                <!-- ================= 字段 4: 备注 (Notes) 原生 CardExpander ================= -->
                                <ui:CardExpander Header="{common:Loc Detail_Field_Notes}"
                                                 Icon="{ui:SymbolIcon Document24}"
                                                 IsExpanded="True"
                                                 Margin="0,0,0,10">
                                    <Grid Margin="0,4,0,0">
                                        <!-- 查看模式（不可编辑）：平整自然排版，带滚动查看 -->
                                        <Grid Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <TextBox Style="{StaticResource FluentReadOnlyMultilineFieldStyle}"
                                                     Text="{Binding Notes}"
                                                     MinHeight="60" MaxHeight="180"
                                                     Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}" />
                                            <ui:TextBlock Text="{common:Loc Detail_NotSet_Notes}"
                                                          FontTypography="Body"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          FontStyle="Italic"
                                                          Margin="0,4"
                                                          Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" />
                                        </Grid>

                                        <!-- 编辑模式（可编辑）：多行表单输入框，带边框与滚动条 -->
                                        <ui:TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True" MinHeight="70" MaxHeight="180"
                                                    PlaceholderText="{common:Loc Detail_Placeholder_Notes}"
                                                    TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </ui:CardExpander>

                                <!-- ================= 字段 5: 自定义附加字段 原生 CardExpander（支持内联编辑） ================= -->
                                <ui:CardExpander Header="{common:Loc Detail_Field_CustomFields}"
                                                 Icon="{ui:SymbolIcon Tag24}"
                                                 IsExpanded="True"
                                                 Margin="0,0,0,10"
                                                 Visibility="{Binding IsCustomFieldsSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding CustomFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- 查看模式：名称 + 只读值 + 保护字段显隐 -->
                                                        <Grid Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType={x:Type ui:DynamicScrollViewer}}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:TextBlock Grid.Column="0" Text="{Binding Key}" FontTypography="BodyStrong" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                            <TextBox Grid.Column="1" Style="{StaticResource FluentReadOnlyFieldStyle}"
                                                                     Text="{Binding DisplayValue}"
                                                                     FontSize="14" />
                                                            <ui:Button Grid.Column="2" Style="{StaticResource ActionIconButtonStyle}" Margin="6,0,0,0"
                                                                       Visibility="{Binding IsProtected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                       Command="{Binding ToggleRevealCommand}" ToolTip="{common:Loc Detail_ViewPlaintext_Tooltip}">
                                                                <ui:SymbolIcon Symbol="Eye20" />
                                                            </ui:Button>
                                                        </Grid>

                                                        <!-- 编辑模式：名称输入 + 值输入（保护字段掩码/明文切换）+ 保护开关 + 删除 -->
                                                        <Grid Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType={x:Type ui:DynamicScrollViewer}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:TextBox Grid.Column="0" Text="{Binding EditKey, UpdateSourceTrigger=PropertyChanged}"
                                                                        PlaceholderText="{common:Loc Detail_CustomField_KeyPlaceholder}"
                                                                        Margin="0,0,6,0" />
                                                            <Grid Grid.Column="1" Margin="0,0,6,0">
                                                                <ui:PasswordBox Password="{Binding EditValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                                PlaceholderText="{common:Loc Detail_CustomField_ValuePlaceholder}"
                                                                                RevealButtonEnabled="False"
                                                                                Visibility="{Binding IsEditValueMaskedBoxVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <ui:TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                                            PlaceholderText="{common:Loc Detail_CustomField_ValuePlaceholder}"
                                                                            Visibility="{Binding IsEditValuePlainBoxVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            </Grid>
                                                            <ui:Button Grid.Column="2" Style="{StaticResource ActionIconButtonStyle}" Margin="2,0"
                                                                       Visibility="{Binding IsProtected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                       Command="{Binding ToggleEditValueVisibilityCommand}" ToolTip="{common:Loc Detail_ViewPlaintext_Tooltip}">
                                                                <ui:SymbolIcon Symbol="Eye20" />
                                                            </ui:Button>
                                                            <ui:Button Grid.Column="3" Style="{StaticResource ActionIconButtonStyle}" Margin="2,0"
                                                                       Command="{Binding ToggleEditProtectionCommand}" ToolTip="{common:Loc Detail_CustomField_ToggleProtect_Tooltip}">
                                                                <Grid>
                                                                    <ui:SymbolIcon Symbol="LockClosed20" Visibility="{Binding IsProtected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <ui:SymbolIcon Symbol="LockOpen20" Visibility="{Binding IsProtected, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                                                </Grid>
                                                            </ui:Button>
                                                            <ui:Button Grid.Column="4" Style="{StaticResource DangerIconButtonStyle}" Margin="2,0"
                                                                       Command="{Binding DataContext.RemoveCustomFieldCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:DynamicScrollViewer}}}"
                                                                       CommandParameter="{Binding}"
                                                                       ToolTip="{common:Loc Detail_CustomField_Remove_Tooltip}">
                                                                <ui:SymbolIcon Symbol="Delete20" />
                                                            </ui:Button>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 编辑模式下的“添加字段”入口 -->
                                        <ui:Button Appearance="Secondary"
                                                   HorizontalAlignment="Left"
                                                   Margin="0,8,0,0"
                                                   Padding="14,6"
                                                   Icon="{ui:SymbolIcon Add20}"
                                                   Content="{common:Loc Detail_CustomField_Add}"
                                                   Command="{Binding AddCustomFieldCommand}"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </ui:CardExpander>

                                <!-- ================= 字段 6: 二进制附件 原生 CardExpander（另存/打开/新增/删除） ================= -->
                                <ui:CardExpander Header="{common:Loc Detail_Field_Attachments}"
                                                 Icon="{ui:SymbolIcon Attach24}"
                                                 IsExpanded="True"
                                                 Margin="0,0,0,10"
                                                 Visibility="{Binding IsAttachmentsSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Attachments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Card Margin="0,3" Padding="12,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:SymbolIcon Grid.Column="0" Symbol="Attach20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorBrush}" />
                                                            <ui:TextBlock Grid.Column="1" Text="{Binding Name}" FontTypography="BodyStrong" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <ui:InfoBadge Grid.Column="2" Value="{Binding SizeDisplay}" Severity="Informational" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                                                                           ToolTip="{common:Loc Detail_AttachmentSave_Tooltip}"
                                                                           Command="{Binding DataContext.SaveAttachmentToDiskCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:DynamicScrollViewer}}}"
                                                                           CommandParameter="{Binding}">
                                                                    <ui:SymbolIcon Symbol="Save20" />
                                                                </ui:Button>
                                                                <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                                                                           ToolTip="{common:Loc Detail_AttachmentView_Tooltip}"
                                                                           Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:DynamicScrollViewer}}}"
                                                                           CommandParameter="{Binding}">
                                                                    <ui:SymbolIcon Symbol="Open20" />
                                                                </ui:Button>
                                                                <ui:Button Style="{StaticResource DangerIconButtonStyle}"
                                                                           ToolTip="{common:Loc Detail_AttachmentDelete_Tooltip}"
                                                                           Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:DynamicScrollViewer}}}"
                                                                           CommandParameter="{Binding}">
                                                                    <ui:SymbolIcon Symbol="Delete20" />
                                                                </ui:Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </ui:Card>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 编辑会话中的“添加附件”入口 -->
                                        <ui:Button Appearance="Secondary"
                                                   HorizontalAlignment="Left"
                                                   Margin="0,8,0,0"
                                                   Padding="14,6"
                                                   Icon="{ui:SymbolIcon Add20}"
                                                   Content="{common:Loc Detail_Attachment_Add}"
                                                   Command="{Binding AddAttachmentCommand}"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </ui:CardExpander>

                                <!-- ================= 字段 7: 历史修改版本 原生 CardExpander ================= -->
                                <ui:CardExpander Header="{Binding HistoryHeader}"
                                                 Icon="{ui:SymbolIcon History24}"
                                                 IsExpanded="False"
                                                 Margin="0,0,0,10"
                                                 Visibility="{Binding HistoryRevisions.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding HistoryRevisions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Card Margin="0,3" Padding="12,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Grid.Column="0" Symbol="History20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <ui:TextBlock Text="{Binding SnapshotTimeDisplay}" FontTypography="BodyStrong" />
                                                            <ui:TextBlock Text="{Binding EntryTitleDisplay}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="2" Appearance="Secondary" Padding="12,4"
                                                                   Command="{Binding RestoreCommand}" ToolTip="{common:Loc Detail_RestoreHistory_Tooltip}"
                                                                   Content="{common:Loc Detail_RestoreHistory_Button}" />
                                                    </Grid>
                                                </ui:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ui:CardExpander>

                                <!-- 底部元数据：创建 / 修改 / 最近访问 / 使用次数 / 过期 -->
                                <ui:CardExpander Header="{Binding MetadataHeader}"
                                                 Icon="{ui:SymbolIcon Clock24}"
                                                 IsExpanded="False"
                                                 Margin="0,8,0,0">
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="{common:Loc Detail_Metadata_Created}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,20,4" />
                                        <ui:TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedTimeDisplay}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBlock Grid.Row="1" Grid.Column="0" Text="{common:Loc Detail_Metadata_LastModified}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,20,4" />
                                        <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastModifiedDisplay}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBlock Grid.Row="2" Grid.Column="0" Text="{common:Loc Detail_Metadata_LastAccess}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,20,4" />
                                        <ui:TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastAccessDisplay}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBlock Grid.Row="3" Grid.Column="0" Text="{common:Loc Detail_Metadata_UsageCount}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,20,4" />
                                        <ui:TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UsageCountDisplay}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBlock Grid.Row="4" Grid.Column="0" Text="{common:Loc Detail_Metadata_Expiry}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,20,4" />
                                        <ui:TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExpiryDisplay}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </ui:CardExpander>
                            </StackPanel>
                        </ui:DynamicScrollViewer>
                    </Grid>
                </ui:Card>
            </Grid>

            </Grid>

            <!-- 现代化设置中心视图 (设置中心开启时展示) -->
            <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:SettingsView DataContext="{Binding Settings}" />
            </Grid>

            <!-- 全局 Toast 提示承载容器 -->
            <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24"
                                  Panel.ZIndex="1000" />
        </Grid>

        <!-- 现代化 Fluent 底部状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info20" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{Binding StatusMessage}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Database20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
