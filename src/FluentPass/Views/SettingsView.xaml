<UserControl x:Class="FluentPass.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FluentPass.ViewModels"
             xmlns:common="clr-namespace:FluentPass.Common"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="750" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
            <!-- 顶部导航标题与返回按钮 -->
            <Grid Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Icon="{ui:SymbolIcon ArrowLeft20}"
                               Appearance="Transparent"
                               ToolTip="{common:Loc Settings_Back_Tooltip}"
                               Command="{Binding CloseSettingsCommand}"
                               Margin="0,0,12,0" />
                    <ui:TextBlock Text="{common:Loc Settings_Nav_Title}" FontTypography="Title" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 分组 1: 行为与接管 -->
            <ui:TextBlock Text="{common:Loc Settings_Section_Behavior}" FontTypography="Subtitle" Margin="0,0,0,8" />
            <StackPanel Margin="0,0,0,24">
                <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon WindowDevTools24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{common:Loc Settings_AutoTakeover_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{common:Loc Settings_AutoTakeover_Description}"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding AutoTakeoverUI, Mode=TwoWay}" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon DismissCircle24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{common:Loc Settings_CloseAction_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{common:Loc Settings_CloseAction_Description}"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox SelectedIndex="{Binding CloseActionIndex, Mode=TwoWay}" Width="220">
                        <ComboBoxItem Content="{common:Loc Settings_CloseAction_Restore}" />
                        <ComboBoxItem Content="{common:Loc Settings_CloseAction_MinimizeTray}" />
                        <ComboBoxItem Content="{common:Loc Settings_CloseAction_Exit}" />
                    </ComboBox>
                </ui:CardControl>
            </StackPanel>

            <!-- 分组 2: 外观与个性化 -->
            <ui:TextBlock Text="{common:Loc Settings_Section_Appearance}" FontTypography="Subtitle" Margin="0,0,0,8" />
            <StackPanel Margin="0,0,0,24">
                <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon WeatherMoon24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{common:Loc Settings_Theme_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{common:Loc Settings_Theme_Description}"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox SelectedValue="{Binding SelectedTheme, Mode=TwoWay}" SelectedValuePath="Tag" Width="200">
                        <ComboBoxItem Content="{common:Loc Settings_Theme_System}" Tag="System" />
                        <ComboBoxItem Content="{common:Loc Settings_Theme_Light}" Tag="Light" />
                        <ComboBoxItem Content="{common:Loc Settings_Theme_Dark}" Tag="Dark" />
                    </ComboBox>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon LocalLanguage24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{common:Loc Settings_Language_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{common:Loc Settings_Language_Description}"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" SelectedValuePath="Tag" Width="260">
                        <ComboBoxItem Content="{common:Loc Settings_Language_Auto}" Tag="Auto" />
                        <ComboBoxItem Content="{common:Loc Settings_Language_ZhCN}" Tag="zh-CN" />
                        <ComboBoxItem Content="{common:Loc Settings_Language_ZhTW}" Tag="zh-TW" />
                        <ComboBoxItem Content="{common:Loc Settings_Language_EnUS}" Tag="en-US" />
                        <ComboBoxItem Content="{common:Loc Settings_Language_DeDE}" Tag="de-DE" />
                        <ComboBoxItem Content="{common:Loc Settings_Language_JaJP}" Tag="ja-JP" />
                        <ComboBoxItem Content="{common:Loc Settings_Language_KoKR}" Tag="ko-KR" />
                        <ComboBoxItem Content="{common:Loc Settings_Language_RuRU}" Tag="ru-RU" />
                        <ComboBoxItem Content="{common:Loc Settings_Language_EsES}" Tag="es-ES" />
                    </ComboBox>
                </ui:CardControl>
            </StackPanel>

            <!-- 分组 3: 安全与防护 -->
            <ui:TextBlock Text="{common:Loc Settings_Section_Security}" FontTypography="Subtitle" Margin="0,0,0,8" />
            <StackPanel Margin="0,0,0,24">
                <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon ShieldCheckmark24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{common:Loc Settings_AutoMask_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{common:Loc Settings_AutoMask_Description}"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Value="{Binding AutoMaskSecondsValue, Mode=TwoWay}"
                                  Minimum="3" Maximum="300"
                                  SmallChange="1" LargeChange="5"
                                  SpinButtonPlacementMode="Compact"
                                  Width="200" />
                </ui:CardControl>
            </StackPanel>

            <!-- 分组 4: 关于与重置 -->
            <ui:TextBlock Text="{common:Loc Settings_Section_About}" FontTypography="Subtitle" Margin="0,0,0,8" />
            <StackPanel Margin="0,0,0,24">
                <ui:CardAction Margin="0,0,0,6"
                               Icon="{ui:SymbolIcon Info24}"
                               Command="{Binding OpenGitHubCommand}">
                    <StackPanel>
                        <ui:TextBlock Text="FluentPass for KeePass" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="{Binding VersionInfoSummary}"
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardAction>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="{common:Loc Settings_Button_Reset}"
                               Icon="{ui:SymbolIcon ArrowReset20}"
                               Appearance="Secondary"
                               Command="{Binding ResetSettingsCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
