<ui:FluentWindow x:Class="KeePassFluentUI.Views.FluentMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KeePassFluentUI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="720" Width="1100"
        MinHeight="520" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 现代化 Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     Icon="/KeePassFluentUI;component/Resources/AppIcon.ico">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ui:Button Appearance="Transparent"
                               Padding="6,4"
                               Margin="0,0,4,0"
                               ToolTip="保存数据库 (Ctrl+S)"
                               Command="{Binding SaveDatabaseCommand}">
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="6,4"
                               Margin="0,0,4,0"
                               ToolTip="锁定所有数据库 (Ctrl+L)"
                               Command="{Binding LockDatabaseCommand}">
                        <ui:SymbolIcon Symbol="LockClosed24" />
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="6,4"
                               Margin="0,0,4,0"
                               ToolTip="切换原版 KeePass 主窗口显示/隐藏"
                               Command="{Binding ToggleOriginalWindowCommand}">
                        <ui:SymbolIcon Symbol="WindowDevTools24" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <!-- 视图 1: 数据库已锁定界面 -->
            <Grid Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="LockClosed48" FontSize="64" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="数据库已锁定"
                                  FontTypography="TitleLarge"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8" />
                    <ui:TextBlock Text="{Binding DatabaseName}"
                                  FontTypography="Body"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24" />
                    <ui:Button Appearance="Primary"
                               Content="立即解锁数据库"
                               Icon="{ui:SymbolIcon Key24}"
                               HorizontalAlignment="Center"
                               Padding="24,10"
                               Command="{Binding UnlockDatabaseCommand}" />
                </StackPanel>
            </Grid>

            <!-- 视图 2: 数据库未打开界面 -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDatabaseOpen}" Value="False" />
                                    <Condition Binding="{Binding IsLocked}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="64" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="未打开任何密码数据库"
                                  FontTypography="TitleLarge"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8" />
                    <ui:TextBlock Text="请在 KeePass 中打开或创建 KDBX 数据库"
                                  FontTypography="Body"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24" />
                    <ui:Button Appearance="Secondary"
                               Content="显示原版窗口进行操作"
                               HorizontalAlignment="Center"
                               Command="{Binding ToggleOriginalWindowCommand}" />
                </StackPanel>
            </Grid>

            <!-- 视图 3: 数据库正常工作区 (三栏骨架，供后续阶段二、三挂载) -->
            <Grid Visibility="{Binding IsDatabaseOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <!-- 左栏: 分组树 -->
                    <ColumnDefinition Width="260" MinWidth="200" MaxWidth="400" />
                    <ColumnDefinition Width="Auto" />
                    <!-- 中栏: 条目列表与搜索 -->
                    <ColumnDefinition Width="400" MinWidth="280" />
                    <ColumnDefinition Width="Auto" />
                    <!-- 右栏: 条目详情与内联编辑 -->
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 左栏卡片占位 -->
                <Border Grid.Column="0"
                        Margin="8,4,4,8"
                        Padding="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" Text="分组目录" FontTypography="BodyStrong" Margin="4,0,0,8" />
                        <ui:TextBlock Grid.Row="1" Text="[分组树加载区 - 阶段二实施]" 
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- 中栏卡片占位 -->
                <Border Grid.Column="2"
                        Margin="4,4,4,8"
                        Padding="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBox Grid.Row="0"
                                    PlaceholderText="搜索密码条目 (Ctrl+F)..."
                                    Margin="0,0,0,8"
                                    Icon="{ui:SymbolIcon Search24}" />
                        <ui:TextBlock Grid.Row="1" Text="[密码列表加载区 - 阶段二实施]" 
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- 右栏卡片占位 -->
                <Border Grid.Column="4"
                        Margin="4,4,8,8"
                        Padding="16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <ui:TextBlock Text="[条目详情与安全操作区 - 阶段二实施]" 
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:TextBlock Text="{Binding StatusMessage}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:TextBlock Text="{Binding DatabasePath}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,12,0" />
                    <ui:TextBlock Text="KeePass Fluent UI v1.0 (In-Process)" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
