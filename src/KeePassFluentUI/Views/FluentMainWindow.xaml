<ui:FluentWindow x:Class="KeePassFluentUI.Views.FluentMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KeePassFluentUI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="760" Width="1200"
        MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FluentCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="ActionIconButtonStyle" TargetType="ui:Button">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 现代化 Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     Icon="/KeePassFluentUI;component/Resources/AppIcon.ico">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               ToolTip="保存数据库 (Ctrl+S)"
                               Command="{Binding SaveDatabaseCommand}">
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               ToolTip="锁定数据库 (Ctrl+L)"
                               Command="{Binding LockDatabaseCommand}">
                        <ui:SymbolIcon Symbol="LockClosed24" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               ToolTip="切换原版 KeePass 主窗口显示/隐藏"
                               Command="{Binding ToggleOriginalWindowCommand}">
                        <ui:SymbolIcon Symbol="WindowDevTools24" />
                    </ui:Button>

                    <!-- 主题切换菜单 -->
                    <Menu Background="Transparent" Margin="4,0,0,0">
                        <MenuItem Padding="6,4">
                            <MenuItem.Header>
                                <ui:SymbolIcon Symbol="WeatherMoon24" />
                            </MenuItem.Header>
                            <MenuItem Header="深色主题 (Dark)" Command="{Binding SwitchThemeCommand}" CommandParameter="Dark" />
                            <MenuItem Header="浅色主题 (Light)" Command="{Binding SwitchThemeCommand}" CommandParameter="Light" />
                            <MenuItem Header="跟随系统 (System)" Command="{Binding SwitchThemeCommand}" CommandParameter="System" />
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <!-- 视图 1: 数据库已锁定 -->
            <Grid Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="LockClosed48" FontSize="64" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="数据库已锁定"
                                  FontTypography="TitleLarge"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8" />
                    <ui:TextBlock Text="{Binding DatabaseName}"
                                  FontTypography="Body"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24" />
                    <ui:Button Appearance="Primary"
                               Content="立即解锁数据库"
                               Icon="{ui:SymbolIcon Key24}"
                               HorizontalAlignment="Center"
                               Padding="24,10"
                               Command="{Binding UnlockDatabaseCommand}" />
                </StackPanel>
            </Grid>

            <!-- 视图 2: 数据库未打开 -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDatabaseOpen}" Value="False" />
                                    <Condition Binding="{Binding IsLocked}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="64" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="未打开任何密码数据库"
                                  FontTypography="TitleLarge"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8" />
                    <ui:TextBlock Text="请在 KeePass 中打开或创建 KDBX 数据库"
                                  FontTypography="Body"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24" />
                    <ui:Button Appearance="Secondary"
                               Content="呼出原版窗口进行操作"
                               HorizontalAlignment="Center"
                               Command="{Binding ToggleOriginalWindowCommand}" />
                </StackPanel>
            </Grid>

            <!-- 视图 3: 三栏现代 Fluent 工作区 -->
            <Grid Visibility="{Binding IsDatabaseOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <!-- 左栏: 分组树 -->
                    <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
                    <ColumnDefinition Width="Auto" />
                    <!-- 中栏: 条目列表与搜索 -->
                    <ColumnDefinition Width="380" MinWidth="280" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <!-- 右栏: 详情与内联编辑 -->
                    <ColumnDefinition Width="*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- ================= 左栏: 分组树 ================= -->
                <Border Grid.Column="0"
                        Style="{StaticResource FluentCardBorderStyle}"
                        Margin="8,4,4,8"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 左栏顶栏工具 -->
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <ui:TextBlock Text="分组目录" FontTypography="BodyStrong" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                                           ToolTip="在选中分组下新建子分组"
                                           Command="{Binding NewGroupCommand}">
                                    <ui:SymbolIcon Symbol="FolderAdd20" />
                                </ui:Button>
                                <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                                           ToolTip="删除当前分组"
                                           Command="{Binding DeleteGroupCommand}">
                                    <ui:SymbolIcon Symbol="Delete20" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!-- 递归分组树 -->
                        <TreeView Grid.Row="1"
                                  ItemsSource="{Binding RootGroups}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  SelectedItemChanged="OnTreeViewSelectedItemChanged">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2,4">
                                        <Image Source="{Binding IconSource}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" />
                                        <TextBlock Text="{Binding EntryCount, StringFormat='{} ({0})'}" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   FontSize="11" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- ================= 中栏: 条目列表与搜索 ================= -->
                <Border Grid.Column="2"
                        Style="{StaticResource FluentCardBorderStyle}"
                        Margin="4,4,4,8"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 搜索框与新建条目 -->
                        <Grid Grid.Row="0" Margin="4,2,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        x:Name="SearchBox"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="实时搜索条目 (Ctrl+F)..."
                                        Icon="{ui:SymbolIcon Search20}"
                                        Margin="0,0,6,0" />
                            <ui:Button Grid.Column="1"
                                       Appearance="Primary"
                                       Content="新建"
                                       Icon="{ui:SymbolIcon Add20}"
                                       Command="{Binding NewEntryCommand}" />
                        </Grid>

                        <!-- 列表统计信息 -->
                        <Grid Grid.Row="1" Margin="6,2,6,4">
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="共 {0} 个条目 (当前显示 {1} 项)">
                                        <Binding Path="TotalEntriesCount" />
                                        <Binding Path="FilteredEntriesCount" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>

                        <!-- 虚拟化条目列表 -->
                        <ListView Grid.Row="2"
                                  ItemsSource="{Binding FilteredEntries}"
                                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="False"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                            Padding="6,8"
                                            Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 图标 -->
                                            <Image Grid.Column="0" Source="{Binding IconSource}" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" />

                                            <!-- 条目文本摘要 -->
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding UserName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                    <TextBlock Text="{Binding LastModifiedDisplay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- ================= 右栏: 条目详情与内联编辑 ================= -->
                <Border Grid.Column="4"
                        Style="{StaticResource FluentCardBorderStyle}"
                        Margin="4,4,8,8"
                        Padding="16">
                    <Grid>
                        <!-- 未选择条目时的空状态 -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDetail}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="56" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />
                                <ui:TextBlock Text="未选择条目" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <ui:TextBlock Text="从左侧或中间列表选择一条凭据以查看详情" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 已选择条目的详情面板 -->
                        <ScrollViewer DataContext="{Binding CurrentDetail}" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel Margin="0,0,8,0">
                                <!-- 顶部标题与操作卡片 -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding IconSource}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding Title}" FontTypography="Title" TextTrimming="CharacterEllipsis" />
                                        <ui:TextBlock Text="{Binding LastModifiedDisplay, StringFormat='{}修改于 {0}'}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <!-- 动作按钮栏 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 查看模式下的工具 -->
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <ui:Button Appearance="Primary" Margin="0,0,4,0" Command="{Binding BeginEditCommand}" Icon="{ui:SymbolIcon Edit20}" Content="编辑" />
                                            <ui:Button Style="{StaticResource ActionIconButtonStyle}" ToolTip="执行全局自动输入 (Auto-Type)" Command="{Binding PerformAutoTypeCommand}">
                                                <ui:SymbolIcon Symbol="Keyboard20" />
                                            </ui:Button>
                                            <ui:Button Style="{StaticResource ActionIconButtonStyle}" ToolTip="调起原版 KeePass 高级编辑窗口" Command="{Binding InvokeOriginalEntryDialogCommand}">
                                                <ui:SymbolIcon Symbol="Open20" />
                                            </ui:Button>
                                        </StackPanel>

                                        <!-- 编辑模式下的工具 -->
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ui:Button Appearance="Primary" Margin="0,0,4,0" Command="{Binding SaveEditCommand}" Icon="{ui:SymbolIcon Checkmark20}" Content="保存" />
                                            <ui:Button Appearance="Secondary" Command="{Binding CancelEditCommand}" Content="取消" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,0,0,16" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                <!-- ================= 字段 1: 用户名 ================= -->
                                <ui:TextBlock Text="用户名 (User Name)" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 查看模式 -->
                                    <ui:TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding UserName}" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                    <!-- 编辑模式 -->
                                    <ui:TextBox Grid.Column="0" Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="6,0,0,0" ToolTip="复制用户名" Command="{Binding CopyUsernameCommand}">
                                        <ui:SymbolIcon Symbol="Copy20" />
                                    </ui:Button>
                                </Grid>

                                <!-- ================= 字段 2: 密码安全交互区 ================= -->
                                <Grid Margin="0,0,0,4">
                                    <ui:TextBlock Text="密码 (Password)" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <!-- 倒计时提示 -->
                                    <TextBlock HorizontalAlignment="Right" Foreground="#FFA500" FontSize="11"
                                               Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Text="{Binding PasswordRevealSecondsRemaining, StringFormat='{}{0} 秒后自动遮蔽'}" />
                                </Grid>

                                <!-- 查看模式下的密码 -->
                                <Grid Margin="0,0,0,12" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 掩码状态展示 -->
                                    <ui:TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding PasswordMasked}" FontFamily="Consolas"
                                                Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                                    <!-- 明文展开状态展示 (带高亮边框警示) -->
                                    <ui:TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding RevealedPassword}" FontFamily="Consolas" FontWeight="SemiBold"
                                                Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <!-- 切换明文按钮 -->
                                    <ui:Button Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="6,0,0,0"
                                               ToolTip="显示/隐藏明文 (10秒自动遮蔽)" Command="{Binding TogglePasswordVisibilityCommand}">
                                        <ui:SymbolIcon Symbol="Eye20" />
                                    </ui:Button>

                                    <!-- 复制密码按钮 -->
                                    <ui:Button Grid.Column="2" Style="{StaticResource ActionIconButtonStyle}" Margin="2,0,0,0"
                                               ToolTip="安全复制密码 (原生剪贴板倒计时自动清空)" Command="{Binding CopyPasswordCommand}">
                                        <ui:SymbolIcon Symbol="Copy20" />
                                    </ui:Button>
                                </Grid>

                                <!-- 编辑模式下的密码 -->
                                <Grid Margin="0,0,0,12" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                    <ui:Button Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="6,0,0,0"
                                               ToolTip="调起原版密码生成器" Command="{Binding InvokePwGeneratorCommand}">
                                        <ui:SymbolIcon Symbol="Wand20" />
                                    </ui:Button>
                                </Grid>

                                <!-- ================= 字段 3: 网址 (URL) ================= -->
                                <ui:TextBlock Text="网址 (URL)" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding Url}" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                    <ui:TextBox Grid.Column="0" Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="6,0,0,0" ToolTip="在默认浏览器中打开" Command="{Binding OpenUrlCommand}">
                                        <ui:SymbolIcon Symbol="Open20" />
                                    </ui:Button>
                                    <ui:Button Grid.Column="2" Style="{StaticResource ActionIconButtonStyle}" Margin="2,0,0,0" ToolTip="复制网址" Command="{Binding CopyUrlCommand}">
                                        <ui:SymbolIcon Symbol="Copy20" />
                                    </ui:Button>
                                </Grid>

                                <!-- ================= 字段 4: 备注 (Notes) ================= -->
                                <ui:TextBlock Text="备注 (Notes)" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,12">
                                    <ui:TextBox IsReadOnly="True" Text="{Binding Notes}" AcceptsReturn="True" MinHeight="70" MaxHeight="140"
                                                TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                    <ui:TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" MaxHeight="140"
                                                TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>

                                <!-- ================= 字段 5: 自定义字段 (Custom Fields) ================= -->
                                <Expander Header="自定义附加字段" IsExpanded="True" Margin="0,0,0,12"
                                          Visibility="{Binding CustomFields.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding CustomFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <ui:TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding DisplayValue}" />
                                                    <ui:Button Grid.Column="2" Style="{StaticResource ActionIconButtonStyle}"
                                                               Visibility="{Binding IsProtected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Command="{Binding ToggleRevealCommand}" ToolTip="查看明文">
                                                        <ui:SymbolIcon Symbol="Eye20" />
                                                    </ui:Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <!-- ================= 字段 6: 附件 (Attachments) ================= -->
                                <Expander Header="二进制附件" IsExpanded="True" Margin="0,0,0,12"
                                          Visibility="{Binding Attachments.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Grid.Column="0" Symbol="Attach20" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <!-- 底部创建与修改时间 -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding CreatedTimeDisplay, StringFormat='{}创建时间: {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,0,16,0" />
                                    <TextBlock Text="{Binding LastModifiedDisplay, StringFormat='{}最后修改: {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:TextBlock Text="{Binding StatusMessage}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:TextBlock Text="{Binding DatabasePath}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,12,0" />
                    <ui:TextBlock Text="KeePass Fluent UI v1.0 (In-Process)" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
