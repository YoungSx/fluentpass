<ui:FluentWindow x:Class="KeePassFluentUI.Views.FluentMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:KeePassFluentUI.ViewModels"
        xmlns:common="clr-namespace:KeePassFluentUI.Common"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="780" Width="1240"
        MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <ResourceDictionary>
            <common:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <common:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

            <Style x:Key="ActionIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="DangerIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>

            <!-- 不可编辑/只读状态下的纯净单行展示样式：去除非编辑状态下的边框与背景，保留划词与复制能力 -->
            <Style x:Key="FluentReadOnlyFieldStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="IBeam" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 不可编辑/只读状态下的纯净多行展示样式（用于备注） -->
            <Style x:Key="FluentReadOnlyMultilineFieldStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Cursor" Value="IBeam" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="Transparent" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 现代化 Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/KeePassFluentUI;component/Resources/AppIcon.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock Text="{Binding WindowTitle}" FontTypography="Caption" VerticalAlignment="Center" Margin="6,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               ToolTip="保存数据库 (Ctrl+S)"
                               Command="{Binding SaveDatabaseCommand}">
                        <ui:SymbolIcon Symbol="Save20" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               ToolTip="锁定数据库 (Ctrl+L)"
                               Command="{Binding LockDatabaseCommand}">
                        <ui:SymbolIcon Symbol="LockClosed20" />
                    </ui:Button>

                    <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               ToolTip="切换原版 KeePass 主窗口显示/隐藏"
                               Command="{Binding ToggleOriginalWindowCommand}">
                        <ui:SymbolIcon Symbol="WindowDevTools20" />
                    </ui:Button>

                    <!-- 主题切换下拉按钮 (TitleBar 交互与 DataContext 穿透) -->
                    <ui:DropDownButton Style="{StaticResource ActionIconButtonStyle}"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       ToolTip="切换外观主题">
                        <ui:DropDownButton.Icon>
                            <ui:SymbolIcon Symbol="WeatherMoon20" />
                        </ui:DropDownButton.Icon>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <ui:MenuItem Header="深色主题 (Dark)"
                                             Icon="WeatherMoon24"
                                             Command="{Binding SwitchThemeCommand}"
                                             CommandParameter="Dark" />
                                <ui:MenuItem Header="浅色主题 (Light)"
                                             Icon="WeatherSunny24"
                                             Command="{Binding SwitchThemeCommand}"
                                             CommandParameter="Light" />
                                <ui:MenuItem Header="跟随系统 (System)"
                                             Icon="Desktop24"
                                             Command="{Binding SwitchThemeCommand}"
                                             CommandParameter="System" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <!-- 视图 1: 数据库已锁定 -->
            <Grid Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="LockClosed48" FontSize="64" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="数据库已锁定"
                                  FontTypography="TitleLarge"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8" />
                    <ui:TextBlock Text="{Binding DatabaseName}"
                                  FontTypography="Body"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24" />
                    <ui:Button Appearance="Primary"
                               Content="立即解锁数据库"
                               Icon="{ui:SymbolIcon Key24}"
                               HorizontalAlignment="Center"
                               Padding="24,10"
                               Command="{Binding UnlockDatabaseCommand}" />
                </StackPanel>
            </Grid>

            <!-- 视图 2: 数据库未打开 -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDatabaseOpen}" Value="False" />
                                    <Condition Binding="{Binding IsLocked}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="64" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="未打开任何密码数据库"
                                  FontTypography="TitleLarge"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8" />
                    <ui:TextBlock Text="请在 KeePass 中打开或创建 KDBX 数据库"
                                  FontTypography="Body"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24" />
                    <ui:Button Appearance="Secondary"
                               Content="呼出原版窗口进行操作"
                               HorizontalAlignment="Center"
                               Command="{Binding ToggleOriginalWindowCommand}" />
                </StackPanel>
            </Grid>

            <!-- 视图 3: 三栏现代 Fluent 工作区容器 (全伸展布局) -->
            <Grid Visibility="{Binding IsDatabaseOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <!-- 左栏: 分组树 -->
                    <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
                    <ColumnDefinition Width="Auto" />
                    <!-- 中栏: 条目列表与搜索 -->
                    <ColumnDefinition Width="380" MinWidth="280" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <!-- 右栏: 详情与内联编辑 -->
                    <ColumnDefinition Width="*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- ================= 左栏: 分组树原生 Card (全高延伸) ================= -->
                <ui:Card Grid.Column="0"
                         Margin="8,4,4,8"
                         Padding="8"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 左栏顶栏工具 -->
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <ui:TextBlock Text="分组目录" FontTypography="BodyStrong" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Style="{StaticResource DangerIconButtonStyle}"
                                           ToolTip="清空回收站"
                                           Visibility="{Binding IsRecycleBinSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Command="{Binding EmptyRecycleBinCommand}">
                                    <ui:SymbolIcon Symbol="Dismiss20" />
                                </ui:Button>
                                <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                                           ToolTip="在选中分组下新建子分组"
                                           Command="{Binding NewGroupCommand}">
                                    <ui:SymbolIcon Symbol="FolderAdd20" />
                                </ui:Button>
                                <ui:Button Style="{StaticResource ActionIconButtonStyle}"
                                           ToolTip="删除当前分组"
                                           Command="{Binding DeleteGroupCommand}">
                                    <ui:SymbolIcon Symbol="Delete20" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!-- 现代 Fluent 递归分组树 -->
                        <TreeView Grid.Row="1"
                                  ItemsSource="{Binding RootGroups}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  VerticalAlignment="Stretch"
                                  SelectedItemChanged="OnTreeViewSelectedItemChanged">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding IconSource}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <ui:TextBlock Grid.Column="1" Text="{Binding Name}" FontTypography="Body" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ui:InfoBadge Grid.Column="2"
                                                      Value="{Binding EntryCount}"
                                                      Severity="Informational"
                                                      Margin="8,0,4,0"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="4,3" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>
                </ui:Card>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- ================= 中栏: 条目列表与搜索原生 Card (全高延伸，彻底杜绝列表为空时的塌陷) ================= -->
                <ui:Card Grid.Column="2"
                         Margin="4,4,4,8"
                         Padding="8"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 搜索框与新建条目 -->
                        <Grid Grid.Row="0" Margin="4,2,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        x:Name="SearchBox"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="实时搜索条目 (Ctrl+F)..."
                                        Icon="{ui:SymbolIcon Search20}"
                                        ClearButtonEnabled="True"
                                        Margin="0,0,6,0" />
                            <ui:Button Grid.Column="1"
                                       Appearance="Primary"
                                       Content="新建"
                                       Icon="{ui:SymbolIcon Add20}"
                                       Command="{Binding NewEntryCommand}" />
                        </Grid>

                        <!-- 列表统计信息与 Win11 官方 ToggleSwitch 开关 -->
                        <Grid Grid.Row="1" Margin="6,2,6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" VerticalAlignment="Center" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <ui:TextBlock.Text>
                                    <MultiBinding StringFormat="共 {0} 个条目 (显示 {1} 项)">
                                        <Binding Path="TotalEntriesCount" />
                                        <Binding Path="FilteredEntriesCount" />
                                    </MultiBinding>
                                </ui:TextBlock.Text>
                            </ui:TextBlock>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ToggleSwitch IsChecked="{Binding ShowSubgroupEntries}"
                                                 Content="子组"
                                                 ToolTip="包含所有子目录中的条目"
                                                 Margin="0,0,12,0" />
                                <ui:ToggleSwitch IsChecked="{Binding IsDatabaseWideSearch}"
                                                 Content="全库"
                                                 ToolTip="在整个密码库范围内搜索" />
                            </StackPanel>
                        </Grid>

                        <!-- 虚拟化原生 ui:ListView 条目列表与空数据友好提示 -->
                        <Grid Grid.Row="2" VerticalAlignment="Stretch">
                            <ui:ListView x:Name="EntriesListView"
                                         ItemsSource="{Binding FilteredEntries}"
                                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalAlignment="Stretch"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.IsDeferredScrollingEnabled="False"
                                         HorizontalContentAlignment="Stretch">
                                <ui:ListView.Resources>
                                    <common:BindingProxy x:Key="MainVmProxy" Data="{Binding}" />
                                </ui:ListView.Resources>
                                <ui:ListView.ItemContainerStyle>
                                    <Style TargetType="ui:ListViewItem" BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListViewItemPreviewMouseRightButtonDown" />
                                    </Style>
                                </ui:ListView.ItemContainerStyle>
                                <ui:ListView.ContextMenu>
                                    <ContextMenu>
                                        <ui:MenuItem Header="复制密码"
                                                     InputGestureText="Ctrl+C"
                                                     Icon="Copy20"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.CopySelectedPasswordCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="复制用户名"
                                                     InputGestureText="Ctrl+B"
                                                     Icon="Person20"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.CopySelectedUsernameCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="复制网址"
                                                     Icon="Link20"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.CopySelectedUrlCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="在浏览器中打开"
                                                     InputGestureText="Ctrl+U"
                                                     Icon="Open20"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.OpenSelectedUrlCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="执行自动输入 (Auto-Type)"
                                                     InputGestureText="Ctrl+V"
                                                     Icon="Keyboard20"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.AutoTypeSelectedCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <Separator />
                                        <ui:MenuItem Header="编辑条目"
                                                     InputGestureText="Enter"
                                                     Icon="Edit20"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.EditSelectedEntryCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <ui:MenuItem Header="删除条目"
                                                     InputGestureText="Del"
                                                     Icon="Delete20"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.DeleteEntryCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                        <Separator />
                                        <ui:MenuItem Header="调起原版 KeePass 编辑窗口"
                                                     Icon="WindowDevTools24"
                                                     Command="{Binding Source={StaticResource MainVmProxy}, Path=Data.OpenOriginalSelectedEntryCommand}"
                                                     CommandParameter="{Binding Source={StaticResource MainVmProxy}, Path=Data.SelectedEntry}" />
                                    </ContextMenu>
                                </ui:ListView.ContextMenu>
                                <ui:ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 图标 -->
                                            <Image Grid.Column="0" Source="{Binding IconSource}" Width="24" Height="24" Margin="4,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                                            <!-- 条目文本摘要 -->
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ui:TextBlock Grid.Row="0" Text="{Binding Title}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                                    <ui:TextBlock Text="{Binding UserName}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                    <ui:TextBlock Text="{Binding LastModifiedDisplay}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ui:ListView.ItemTemplate>
                            </ui:ListView>

                            <!-- 当条目列表为空时的友好 Fluent 占位卡片 -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding FilteredEntries.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="44" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10" />
                                <ui:TextBlock Text="无密码条目" FontTypography="BodyStrong" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <ui:TextBlock Text="当前分组下暂无条目，可点击上方「+ 新建」或开启「子组」展示"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              HorizontalAlignment="Center"
                                              TextWrapping="Wrap"
                                              TextAlignment="Center"
                                              MaxWidth="240"
                                              Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ui:Card>

                <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                <!-- ================= 右栏: 条目详情与内联编辑原生 Card (全高延伸) ================= -->
                <ui:Card Grid.Column="4"
                         Margin="4,4,8,8"
                         Padding="16"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                    <Grid VerticalAlignment="Stretch">
                        <!-- 未选择条目时的空状态 -->
                        <Grid VerticalAlignment="Stretch">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDetail}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="56" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />
                                <ui:TextBlock Text="未选择条目" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <ui:TextBlock Text="从左侧或中间列表选择一条凭据以查看详情" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 已选择条目的详情面板 (采用 DynamicScrollViewer 实现平滑流动滚动) -->
                        <ui:DynamicScrollViewer DataContext="{Binding CurrentDetail}" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                            <ui:DynamicScrollViewer.Style>
                                <Style TargetType="ui:DynamicScrollViewer" BasedOn="{StaticResource {x:Type ui:DynamicScrollViewer}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:DynamicScrollViewer.Style>

                            <StackPanel Margin="0,0,8,0">
                                <!-- 顶部标题与操作卡片 -->
                                <ui:Card Margin="0,0,0,14" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0" Source="{Binding IconSource}" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        
                                        <!-- 查看模式标题 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <ui:TextBlock Text="{Binding Title}" FontTypography="Title" TextTrimming="CharacterEllipsis" />
                                            <ui:TextBlock Text="{Binding LastModifiedDisplay, StringFormat='{}修改于 {0}'}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- 编辑模式标题 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ui:TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="条目标题"
                                                        FontSize="16"
                                                        ClearButtonEnabled="True"
                                                        Margin="0,0,0,4" />
                                            <ui:InfoBadge Severity="Attention" Value="正在编辑条目" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <!-- 动作按钮栏 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 查看模式下的工具 -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <ui:Button Appearance="Primary" Margin="0,0,6,0" Command="{Binding BeginEditCommand}" Icon="{ui:SymbolIcon Edit20}" Content="编辑" />
                                                <ui:Button Style="{StaticResource ActionIconButtonStyle}" ToolTip="执行全局自动输入 (Auto-Type)" Command="{Binding PerformAutoTypeCommand}">
                                                    <ui:SymbolIcon Symbol="Keyboard20" />
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource ActionIconButtonStyle}" ToolTip="调起原版 KeePass 高级编辑窗口" Command="{Binding InvokeOriginalEntryDialogCommand}">
                                                    <ui:SymbolIcon Symbol="Open20" />
                                                </ui:Button>
                                            </StackPanel>

                                            <!-- 编辑模式下的工具 -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ui:Button Appearance="Primary" Margin="0,0,6,0" Command="{Binding SaveEditCommand}" Icon="{ui:SymbolIcon Checkmark20}" Content="保存" />
                                                <ui:Button Appearance="Secondary" Command="{Binding CancelEditCommand}" Content="取消" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <!-- ================= 字段 1: 用户名 ================= -->
                                <ui:Card Margin="0,0,0,10" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                            <ui:SymbolIcon Symbol="Person20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="用户名 (User Name)" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- 查看模式（不可编辑）：平整纯净展示，支持鼠标划词与一键复制 -->
                                        <Grid Grid.Row="1" Grid.Column="0" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" VerticalAlignment="Center">
                                            <TextBox Style="{StaticResource FluentReadOnlyFieldStyle}"
                                                     Text="{Binding UserName}"
                                                     FontSize="14"
                                                     Visibility="{Binding UserName, Converter={StaticResource StringToVisibilityConverter}}" />
                                            <ui:TextBlock Text="（未设置用户名）"
                                                          FontTypography="Body"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          FontStyle="Italic"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding UserName, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" />
                                        </Grid>

                                        <!-- 编辑模式（可编辑）：标准的 Fluent 输入框，带有清晰边框、底色与清除按钮 -->
                                        <ui:TextBox Grid.Row="1" Grid.Column="0"
                                                    Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="请输入用户名"
                                                    ClearButtonEnabled="True"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="8,0,0,0" ToolTip="复制用户名" Command="{Binding CopyUsernameCommand}">
                                            <ui:SymbolIcon Symbol="Copy20" />
                                        </ui:Button>
                                    </Grid>
                                </ui:Card>

                                <!-- ================= 字段 2: 密码安全交互区 ================= -->
                                <ui:Card Margin="0,0,0,10" Padding="14,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Key20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ui:TextBlock Text="密码 (Password)" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- 倒计时安全提示使用 Fluent InfoBadge -->
                                            <ui:InfoBadge HorizontalAlignment="Right"
                                                          Severity="Caution"
                                                          Value="{Binding PasswordRevealSecondsRemaining, StringFormat='{}{0} 秒后自动遮蔽'}"
                                                          Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>

                                        <!-- 查看模式下的密码（不可编辑状态：平整展示与安全遮蔽） -->
                                        <Grid Margin="0,0,0,8" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 掩码状态展示（无边框平整展示） -->
                                            <TextBox Grid.Column="0" Style="{StaticResource FluentReadOnlyFieldStyle}"
                                                     Text="{Binding PasswordMasked}" FontFamily="Consolas" FontSize="16"
                                                     Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                                            <!-- 明文展开状态展示（无边框平整展示） -->
                                            <TextBox Grid.Column="0" Style="{StaticResource FluentReadOnlyFieldStyle}"
                                                     Text="{Binding RevealedPassword}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                                     Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <!-- 切换明文按钮 -->
                                            <ui:Button Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="8,0,0,0"
                                                       ToolTip="显示/隐藏明文 (10秒后自动遮蔽)" Command="{Binding TogglePasswordVisibilityCommand}">
                                                <ui:SymbolIcon Symbol="Eye20" />
                                            </ui:Button>

                                            <!-- 复制密码按钮 -->
                                            <ui:Button Grid.Column="2" Appearance="Primary" Margin="4,0,0,0"
                                                       ToolTip="安全复制密码 (原版剪贴板倒计时自动清空)" Command="{Binding CopyPasswordCommand}">
                                                <ui:SymbolIcon Symbol="Copy20" />
                                            </ui:Button>
                                        </Grid>

                                        <!-- 编辑模式下的密码（可编辑状态：表单密码输入框，带边框和占位提示） -->
                                        <Grid Margin="0,0,0,8" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 明文输入框 -->
                                            <ui:TextBox Grid.Column="0"
                                                        Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}"
                                                        FontFamily="Consolas"
                                                        PlaceholderText="输入密码"
                                                        Visibility="{Binding IsEditPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <!-- 密文输入框 -->
                                            <ui:PasswordBox Grid.Column="0"
                                                            Password="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                            FontFamily="Consolas"
                                                            Visibility="{Binding IsEditPasswordRevealed, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                                            <!-- 切换防窥显隐 -->
                                            <ui:Button Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="8,0,0,0"
                                                       ToolTip="显示/隐藏明文 (防窥保护)" Command="{Binding ToggleEditPasswordVisibilityCommand}">
                                                <ui:SymbolIcon Symbol="Eye20" />
                                            </ui:Button>

                                            <!-- 调起原版密码生成器 -->
                                            <ui:Button Grid.Column="2" Style="{StaticResource ActionIconButtonStyle}" Margin="4,0,0,0"
                                                       ToolTip="调起原版密码生成器" Command="{Binding InvokePwGeneratorCommand}">
                                                <ui:SymbolIcon Symbol="Wand20" />
                                            </ui:Button>
                                        </Grid>

                                        <!-- 密码质量与熵值估算指示条 -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Height="4" VerticalAlignment="Center"
                                                         Value="{Binding PasswordQualityPercent}" Maximum="100"
                                                         Foreground="{Binding PasswordQualityColor}" Margin="0,0,8,0" />
                                            <ui:TextBlock Grid.Column="1" Text="{Binding PasswordQualityText}" FontTypography="Caption"
                                                          Foreground="{Binding PasswordQualityColor}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <!-- ================= 字段 3: 网址 (URL) ================= -->
                                <ui:Card Margin="0,0,0,10" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                            <ui:SymbolIcon Symbol="Globe20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="网址 (URL)" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- 查看模式（不可编辑）：平整展示，支持划词复制与快捷打开 -->
                                        <Grid Grid.Row="1" Grid.Column="0" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" VerticalAlignment="Center">
                                            <TextBox Style="{StaticResource FluentReadOnlyFieldStyle}"
                                                     Text="{Binding Url}"
                                                     FontSize="14"
                                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                     Visibility="{Binding Url, Converter={StaticResource StringToVisibilityConverter}}" />
                                            <ui:TextBlock Text="（未设置网址）"
                                                          FontTypography="Body"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          FontStyle="Italic"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding Url, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" />
                                        </Grid>

                                        <!-- 编辑模式（可编辑）：带边框的 Fluent 输入框 -->
                                        <ui:TextBox Grid.Row="1" Grid.Column="0"
                                                    Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="https://..."
                                                    ClearButtonEnabled="True"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionIconButtonStyle}" Margin="8,0,0,0" ToolTip="在默认浏览器中打开" Command="{Binding OpenUrlCommand}">
                                            <ui:SymbolIcon Symbol="Open20" />
                                        </ui:Button>
                                        <ui:Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionIconButtonStyle}" Margin="4,0,0,0" ToolTip="复制网址" Command="{Binding CopyUrlCommand}">
                                            <ui:SymbolIcon Symbol="Copy20" />
                                        </ui:Button>
                                    </Grid>
                                </ui:Card>

                                <!-- ================= 字段 4: 备注 (Notes) 原生 CardExpander ================= -->
                                <ui:CardExpander Header="备注 (Notes)"
                                                 Icon="Document24"
                                                 IsExpanded="True"
                                                 Margin="0,0,0,10">
                                    <Grid Margin="0,4,0,0">
                                        <!-- 查看模式（不可编辑）：平整自然排版，带滚动查看 -->
                                        <Grid Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                            <TextBox Style="{StaticResource FluentReadOnlyMultilineFieldStyle}"
                                                     Text="{Binding Notes}"
                                                     MinHeight="60" MaxHeight="180"
                                                     Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}" />
                                            <ui:TextBlock Text="（无备注内容）"
                                                          FontTypography="Body"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          FontStyle="Italic"
                                                          Margin="0,4"
                                                          Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" />
                                        </Grid>

                                        <!-- 编辑模式（可编辑）：多行表单输入框，带边框与滚动条 -->
                                        <ui:TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True" MinHeight="70" MaxHeight="180"
                                                    PlaceholderText="请输入备注信息..."
                                                    TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </ui:CardExpander>

                                <!-- ================= 字段 5: 自定义附加字段 原生 CardExpander ================= -->
                                <ui:CardExpander Header="自定义附加字段"
                                                 Icon="Tag24"
                                                 IsExpanded="True"
                                                 Margin="0,0,0,10"
                                                 Visibility="{Binding CustomFields.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding CustomFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBlock Grid.Column="0" Text="{Binding Key}" FontTypography="BodyStrong" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                    <TextBox Grid.Column="1" Style="{StaticResource FluentReadOnlyFieldStyle}"
                                                             Text="{Binding DisplayValue}"
                                                             FontSize="14" />
                                                    <ui:Button Grid.Column="2" Style="{StaticResource ActionIconButtonStyle}" Margin="6,0,0,0"
                                                               Visibility="{Binding IsProtected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Command="{Binding ToggleRevealCommand}" ToolTip="查看明文">
                                                        <ui:SymbolIcon Symbol="Eye20" />
                                                    </ui:Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ui:CardExpander>

                                <!-- ================= 字段 6: 二进制附件 原生 CardExpander ================= -->
                                <ui:CardExpander Header="二进制附件"
                                                 Icon="Attach24"
                                                 IsExpanded="True"
                                                 Margin="0,0,0,10"
                                                 Visibility="{Binding Attachments.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Card Margin="0,3" Padding="12,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Grid.Column="0" Symbol="Attach20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorBrush}" />
                                                        <ui:TextBlock Grid.Column="1" Text="{Binding Name}" FontTypography="BodyStrong" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <ui:InfoBadge Grid.Column="2" Value="{Binding SizeDisplay}" Severity="Informational" VerticalAlignment="Center" />
                                                    </Grid>
                                                </ui:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ui:CardExpander>

                                <!-- ================= 字段 7: 历史修改版本 原生 CardExpander ================= -->
                                <ui:CardExpander Header="{Binding HistoryRevisions.Count, StringFormat='{}历史版本快照 ({0})'}"
                                                 Icon="History24"
                                                 IsExpanded="False"
                                                 Margin="0,0,0,10"
                                                 Visibility="{Binding HistoryRevisions.Count, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding HistoryRevisions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Card Margin="0,3" Padding="12,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Grid.Column="0" Symbol="History20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <ui:TextBlock Text="{Binding LastModifiedDisplay, StringFormat='{}快照时间: {0}'}" FontTypography="BodyStrong" />
                                                            <ui:TextBlock Text="{Binding Title, StringFormat='{}条目标题: {0}'}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="2" Appearance="Secondary" Padding="12,4"
                                                                   Command="{Binding RestoreCommand}" ToolTip="将条目还原至此历史版本 (当前状态将自动创建新快照)">
                                                            还原
                                                        </ui:Button>
                                                    </Grid>
                                                </ui:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ui:CardExpander>

                                <!-- 底部创建与修改时间 -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ui:TextBlock Text="{Binding CreatedTimeDisplay, StringFormat='{}创建时间: {0}'}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,16,0" />
                                    <ui:TextBlock Text="{Binding LastModifiedDisplay, StringFormat='{}最后修改: {0}'}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:DynamicScrollViewer>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- 全局 Toast 提示承载容器 -->
            <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,24"
                                  Panel.ZIndex="1000" />
        </Grid>

        <!-- 现代化 Fluent 底部状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Info20" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="{Binding StatusMessage}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Database20" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock Text="{Binding DatabasePath}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <ui:SymbolIcon Symbol="ShieldCheckmark20" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <ui:TextBlock Text="Fluent Pass (In-Process)" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
