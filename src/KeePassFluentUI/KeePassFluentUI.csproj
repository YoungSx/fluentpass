<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>KeePassFluentUI</AssemblyName>
    <RootNamespace>KeePassFluentUI</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- 自动探测本机 KeePass 2.x 安装路径 -->
    <KeePassDir Condition="'$(KeePassDir)' == '' and Exists('C:\Program Files\KeePass Password Safe 2\KeePass.exe')">C:\Program Files\KeePass Password Safe 2</KeePassDir>
    <KeePassDir Condition="'$(KeePassDir)' == '' and Exists('C:\Program Files (x86)\KeePass Password Safe 2\KeePass.exe')">C:\Program Files (x86)\KeePass Password Safe 2</KeePassDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="KeePass" Condition="Exists('$(KeePassDir)\KeePass.exe')">
      <HintPath>$(KeePassDir)\KeePass.exe</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

</Project>
